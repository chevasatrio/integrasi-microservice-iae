APP_NAME=ProductService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

DB_CONNECTION=mysql
DB_HOST=product-db
DB_PORT=3306
DB_DATABASE=productservice_db
DB_USERNAME=root
DB_PASSWORD=secret

# ← Pakai rabbitmq sebagai driver queue
QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=product-stock-update