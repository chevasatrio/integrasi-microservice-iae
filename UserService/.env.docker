APP_NAME=UserService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=user-db          # ← nama container MySQL di docker-compose
DB_PORT=3306
DB_DATABASE=userservice_db
DB_USERNAME=root
DB_PASSWORD=secret

QUEUE_CONNECTION=sync    # UserService tidak pakai queue